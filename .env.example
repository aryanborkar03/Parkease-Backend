# ─────────────────────────────────────────────────────────────────────────────
# ParkEase Backend — Root Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MySQL (host machine, accessed via host.docker.internal from containers) ──
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ── Spring Boot Admin & Eureka credentials ────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# ── Default Admin Account (seeded by auth-service on first startup) ───────────
# Set ENABLE_DEFAULT_ADMIN=true only on first run; set to false afterward.
ADMIN_EMAIL=admin@parkease.com
ADMIN_FULL_NAME=Admin User
ENABLE_DEFAULT_ADMIN=true
